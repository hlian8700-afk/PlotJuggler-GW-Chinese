{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bladescope.local/schemas/condition-pack-v1",
  "title": "BladeScope scoped condition pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "vendor",
    "model",
    "conditions"
  ],
  "properties": {
    "format": {
      "const": "bladescope.condition-pack.v1"
    },
    "conditions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "family",
          "state",
          "primary_role",
          "unit",
          "threshold"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "family": {
            "enum": [
              "overspeed",
              "pitch_following",
              "vibration_ac_rms",
              "speed_fluctuation_rms"
            ]
          },
          "state": {
            "enum": [
              "draft",
              "pending_validation",
              "validated",
              "disabled"
            ]
          },
          "primary_role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,80}$"
          },
          "reference_role": {
            "type": "string",
            "maxLength": 80
          },
          "unit": {
            "enum": [
              "rpm",
              "deg",
              "m/s2",
              "mm/s"
            ]
          },
          "threshold": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 4096
          },
          "source_row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "reviewer": {
            "type": "string",
            "maxLength": 512
          },
          "review_date": {
            "type": "string",
            "maxLength": 512
          },
          "case_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "merge_identical": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "maximum_gap_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "tolerance_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "minimum_cycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "pending_validation",
                    "validated"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "source"
              ],
              "properties": {
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "source": {
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "validated"
                }
              }
            },
            "then": {
              "required": [
                "reviewer",
                "review_date",
                "case_ids"
              ],
              "properties": {
                "reviewer": {
                  "minLength": 1
                },
                "review_date": {
                  "format": "date"
                },
                "case_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
